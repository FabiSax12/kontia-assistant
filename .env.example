# Clave de Google AI Studio. Si queda vacía, el sistema corre en MODO MOCK (sin gastar API).
GEMINI_API_KEY=

# Nombres de modelo: confirmalos en Google AI Studio (https://aistudio.google.com).
# Si quedan vacíos y hay key, la app elige solos un Flash-Lite (análisis) y un Flash (respuesta) con client.models.list().
MODELO_ANALISIS=
MODELO_RESPUESTA=

UMBRAL_SIMILITUD=0.45
TIMEOUT_S=20
PAUSA_EVAL_S=4
